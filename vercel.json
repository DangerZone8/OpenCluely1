{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.js",
  "installCommand": "echo 'Static Vercel deployment: no npm install required'",
  "outputDirectory": "web-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/gemini.js": {
      "maxDuration": 30
    },
    "api/updates/[...path].js": {
      "maxDuration": 15
    }
  }
}
